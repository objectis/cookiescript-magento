<?php
/**
 * The "Website scanner" panel of Stores > Configuration > CookieScript.
 * Interactive parts are handled by CookieScript_Banner/js/scanner.
 */
declare(strict_types=1);

use CookieScript\Banner\Block\Adminhtml\System\Config\Scanner;
use Magento\Framework\Escaper;

/** @var Scanner $block */
/** @var Escaper $escaper */

$cookieGroups = $block->getCookieGroups();
?>
<div id="cookiescript-scanner" class="cookiescript-scanner">

    <p class="cookiescript-scanner__intro" data-role="intro">
        <?php if ($block->hasBannerScript()): ?>
            <?= $escaper->escapeHtml(__('We have created a Cookie Declaration and a banner for your website. You can scan the website again to update them.')) ?>
        <?php else: ?>
            <?= $escaper->escapeHtml(__('To create a banner that lists the cookies your website really uses, we need to look at your site. We will scan your website to find all of its cookies.')) ?>
        <?php endif; ?>
        <br>
        <strong><?= $escaper->escapeHtml(__('After the scan, set "Enable CookieScript banner" to Yes and save the configuration.')) ?></strong>
    </p>

    <?php if ($block->isInherited()): ?>
        <p class="cookiescript-scanner__note">
            <?= $escaper->escapeHtml(__('This is the scan of %1. Scan again to give this scope its own banner.', $block->getEffectiveScopeLabel())) ?>
        </p>
    <?php endif; ?>

    <div class="cookiescript-scanner__actions">
        <button type="button" class="action-default scalable primary" data-role="open-scan-form">
            <span><?= $escaper->escapeHtml($block->hasBannerScript() ? __('Re-scan website') : __('Scan website')) ?></span>
        </button>
        <button type="button" class="action-default scalable" data-role="update-script"
                <?= $block->hasBannerScript() ? '' : 'hidden' ?>>
            <span><?= $escaper->escapeHtml(__('Update banner script')) ?></span>
        </button>
        <span class="cookiescript-scanner__message" data-role="message" role="status" aria-live="polite"></span>
    </div>

    <div class="cookiescript-scanner__form" data-role="scan-form" hidden>
        <p><?= $escaper->escapeHtml(__('We need a bit more information about your website. Enter the address of your cookie policy page (optional) and choose the main language of your banner.')) ?></p>
        <div class="admin__field">
            <label class="admin__field-label" for="cookiescript_policy_url">
                <span><?= $escaper->escapeHtml(__('Cookie policy page URL')) ?></span>
            </label>
            <div class="admin__field-control">
                <input type="url" id="cookiescript_policy_url" class="admin__control-text"
                       data-role="policy-url" maxlength="255"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('https://example.com/cookie-policy')) ?>"
                       value="<?= $escaper->escapeHtmlAttr($block->getPolicyUrl()) ?>">
            </div>
        </div>
        <div class="admin__field">
            <label class="admin__field-label" for="cookiescript_language">
                <span><?= $escaper->escapeHtml(__('Banner language')) ?></span>
            </label>
            <div class="admin__field-control">
                <select id="cookiescript_language" class="admin__control-select" data-role="language">
                    <option value=""><?= $escaper->escapeHtml(__('-- Please select --')) ?></option>
                    <?php foreach ($block->getLanguageOptions() as $option): ?>
                        <option value="<?= $escaper->escapeHtmlAttr($option['value']) ?>"
                            <?= $option['value'] === $block->getLanguage() ? 'selected="selected"' : '' ?>>
                            <?= $escaper->escapeHtml($option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>
        <div class="cookiescript-scanner__actions">
            <button type="button" class="action-default scalable primary" data-role="start-scan">
                <span><?= $escaper->escapeHtml(__('Start scan')) ?></span>
            </button>
            <button type="button" class="action-default scalable" data-role="cancel-scan">
                <span><?= $escaper->escapeHtml(__('Cancel')) ?></span>
            </button>
        </div>
    </div>

    <div class="cookiescript-scanner__scanning" data-role="scanning" hidden>
        <span class="cookiescript-scanner__spinner" aria-hidden="true"></span>
        <?= $escaper->escapeHtml(__('Scanning your website. This can take a few minutes; you can leave this page open or come back later.')) ?>
    </div>

    <div class="cookiescript-scanner__report" data-role="report-wrapper" <?= $cookieGroups === [] ? 'hidden' : '' ?>>
        <h4><?= $escaper->escapeHtml(__('Your Cookie Declaration report')) ?></h4>
        <div class="admin__table-wrapper">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Name')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Category')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Provider/Domain')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Expiration')) ?></th>
                        <th class="data-grid-th"><?= $escaper->escapeHtml(__('Description')) ?></th>
                    </tr>
                </thead>
                <tbody data-role="report-body">
                    <?php foreach ($cookieGroups as $group): ?>
                        <?php foreach ((array) ($group['cookies'] ?? []) as $cookie): ?>
                            <tr>
                                <td><?= $escaper->escapeHtml((string) ($cookie['name'] ?? '')) ?></td>
                                <td><?= $escaper->escapeHtml((string) ($group['type_name'] ?? '')) ?></td>
                                <td><?= $escaper->escapeHtml((string) ($cookie['domain'] ?? '')) ?></td>
                                <td><?= $escaper->escapeHtml((string) ($cookie['expire'] ?? '')) ?></td>
                                <td><?= $escaper->escapeHtml((string) ($cookie['desc'] ?? '')) ?></td>
                            </tr>
                        <?php endforeach; ?>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
        <p class="cookiescript-scanner__note">
            <?= $escaper->escapeHtml(__('To edit this report, create an account at Cookie-Script.com and use the dashboard to adjust the banner settings and the Cookie Declaration.')) ?>
        </p>
    </div>
</div>

<script type="text/x-magento-init">
{
    "#cookiescript-scanner": {
        "CookieScript_Banner/js/scanner": <?= /* @noEscape */ $block->getScriptConfigJson() ?>
    }
}
</script>
