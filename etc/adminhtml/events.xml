<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Fired after the "Stores > Configuration > CookieScript" section is saved -->
    <event name="admin_system_config_changed_section_cookiescript">
        <observer name="cookiescript_invalidate_page_cache"
                  instance="CookieScript\Banner\Observer\InvalidatePageCache"/>
    </event>
</config>
